import matplotlib.pyplot as plt

# Training data
data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]

# Initial hypothesis
hypothesis = ['0', '0', '0', '0', '0', '0']

# FIND-S Algorithm
for row in data:
    if row[-1] == 'Yes':
        for i in range(6):
            if hypothesis[i] == '0':
                hypothesis[i] = row[i]
            elif hypothesis[i] != row[i]:
                hypothesis[i] = '?'

# Print result
print("Most Specific Hypothesis:")
print(hypothesis)

# Plot hypothesis using Matplotlib
plt.figure(figsize=(10, 4))
plt.bar(range(6), [1] * 6)
plt.xticks(range(6),
           ['Sky', 'Temperature', 'Humidity',
            'Wind', 'Water', 'Forecast'])
plt.ylabel("Hypothesis")
plt.title("FIND-S Algorithm - Final Hypothesis")

# Display hypothesis values
for i, value in enumerate(hypothesis):
    plt.text(i, 1.02, value, ha='center', fontsize=12)

plt.ylim(0, 1.3)
plt.show()
